<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <!-- Fallback brushes: define keys expected by older MaterialDesign resource dictionaries
         These ensure `PrimaryHueMidBrush` and `SecondaryHueMidBrush` resolve if the
         merged MaterialDesign resources don't provide them. Adjust colors as needed. -->
    <SolidColorBrush x:Key="PrimaryHueMidBrush" Color="#6200EE" />
    <SolidColorBrush x:Key="SecondaryHueMidBrush" Color="#03DAC6" />

    <!-- Card fallback: use Border so XAML doesn't require MaterialDesign Card type at design time -->
    <Style TargetType="Border" x:Key="CustomCard">
        <Setter Property="Padding" Value="20"/>
        <Setter Property="Margin" Value="0,0,0,20"/>
        <Setter Property="Background" Value="{DynamicResource MaterialDesignCard}" />
    </Style>

    <Style TargetType="Button" x:Key="PrimaryButton">
        <Setter Property="Background" Value="{DynamicResource PrimaryHueMidBrush}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Padding" Value="14,6"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <!-- Header Text -->
    <Style TargetType="TextBlock" x:Key="HeaderText">
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryHueMidBrush}"/>
    </Style>

    <!-- Table Header Cell -->
    <Style TargetType="Border" x:Key="TableHeaderCell">
        <Setter Property="Background" Value="{DynamicResource PrimaryHueMidBrush}"/>
        <Setter Property="Padding" Value="8"/>
    </Style>

    <Style TargetType="TextBlock" x:Key="TableHeaderText" >
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Data value text -->
    <Style TargetType="TextBlock" x:Key="DataValueText">
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Highlighted value box -->
    <Style TargetType="Border" x:Key="ValueBox">
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="8"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- Status text -->
    <Style TargetType="TextBlock" x:Key="StatusText">
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource SecondaryHueMidBrush}"/>
    </Style>

    <!-- Inputs -->
    <Style TargetType="TextBox" x:Key="DefaultTextBox">
        <Setter Property="MinWidth" Value="120"/>
    </Style>

    <Style TargetType="ComboBox" x:Key="DefaultComboBox"/>

</ResourceDictionary>