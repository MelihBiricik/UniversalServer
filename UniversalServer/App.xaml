<Application x:Class="UniversalServer.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <!-- MaterialDesign Ressourcen einbinden -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.Light.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Eigene Farben -->
            <Color x:Key="PrimaryColor">#024959</Color>
            <Color x:Key="SecondaryColor">#026773</Color>

            <SolidColorBrush x:Key="PrimaryHueMidBrush" Color="{StaticResource PrimaryColor}" />
            <SolidColorBrush x:Key="SecondaryHueMidBrush" Color="{StaticResource SecondaryColor}" />

            <SolidColorBrush x:Key="OnPrimaryBrush" Color="#FFFFFF" />

            <SolidColorBrush x:Key="TempContainerBrush" Color="#E0F2F1" />
            <SolidColorBrush x:Key="FeuchteContainerBrush" Color="#E8F5E9" />
            <SolidColorBrush x:Key="DruckContainerBrush" Color="#E0F7FA" />
            <SolidColorBrush x:Key="ContainerTextBrush" Color="#012730" />

            <!-- Eigene Styles -->
            <Style TargetType="Border" x:Key="CustomCard">
                <Setter Property="Padding" Value="24"/>
                <Setter Property="Margin" Value="0,0,0,16"/>
                <Setter Property="Background" Value="{DynamicResource MaterialDesignCard}" />
                <Setter Property="CornerRadius" Value="12"/>
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect BlurRadius="15" ShadowDepth="1" Opacity="0.08" Color="Black"/>
                    </Setter.Value>
                </Setter>
            </Style>

    <Style TargetType="Button" x:Key="PrimaryButton">
                <Setter Property="Background" Value="{DynamicResource PrimaryHueMidBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource PrimaryHueMidBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource OnPrimaryBrush}"/>
                <Setter Property="Padding" Value="16,10"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="8"/>
            </Style>

            <Style TargetType="TextBlock" x:Key="HeaderText">
                <Setter Property="FontSize" Value="24"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Foreground" Value="{DynamicResource PrimaryHueMidBrush}"/>
            </Style>

            <Style TargetType="Border" x:Key="TableHeaderCell">
                <Setter Property="Background" Value="{DynamicResource SecondaryHueMidBrush}"/>
                <Setter Property="Padding" Value="12,8"/>
                <Setter Property="CornerRadius" Value="4"/>
                <Setter Property="Margin" Value="2"/>
            </Style>

            <Style TargetType="TextBlock" x:Key="DataValueText">
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}"/>
            </Style>

            <Style TargetType="Border" x:Key="ValueBox">
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="12,8"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
            </Style>

            <Style TargetType="TextBlock" x:Key="StatusText">
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{DynamicResource PrimaryHueMidBrush}"/>
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>